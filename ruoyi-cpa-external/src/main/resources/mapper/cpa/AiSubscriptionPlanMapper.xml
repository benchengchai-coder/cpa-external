<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cpaexternal.subscription.mapper.AiSubscriptionPlanMapper">

    <resultMap type="AiSubscriptionPlan" id="AiSubscriptionPlanResult">
        <id     property="planId"                  column="plan_id" />
        <result property="title"                   column="title" />
        <result property="subTitle"                column="sub_title" />
        <result property="priceAmount"             column="price_amount" />
        <result property="durationUnit"            column="duration_unit" />
        <result property="durationValue"           column="duration_value" />
        <result property="customSeconds"           column="custom_seconds" />
        <result property="amountTotal"             column="amount_total" />
        <result property="quotaResetPeriod"        column="quota_reset_period" />
        <result property="quotaResetCustomSeconds" column="quota_reset_custom_seconds" />
        <result property="status"                  column="status" />
        <result property="sortOrder"               column="sort_order" />
        <result property="maxPurchasePerUser"      column="max_purchase_per_user" />
        <result property="allowBalancePurchase"    column="allow_balance_purchase" />
        <result property="createBy"                column="create_by" />
        <result property="createTime"              column="create_time" />
        <result property="updateBy"                column="update_by" />
        <result property="updateTime"              column="update_time" />
        <result property="remark"                  column="remark" />
    </resultMap>

    <sql id="selectAiSubscriptionPlanVo">
        select p.plan_id, p.title, p.sub_title, p.price_amount, p.duration_unit, p.duration_value,
               p.custom_seconds, p.amount_total, p.quota_reset_period, p.quota_reset_custom_seconds,
               p.status, p.sort_order, p.max_purchase_per_user, p.allow_balance_purchase,
               p.create_by, p.create_time, p.update_by, p.update_time, p.remark
        from ai_subscription_plan p
    </sql>

    <select id="selectAiSubscriptionPlanById" parameterType="Long" resultMap="AiSubscriptionPlanResult">
        <include refid="selectAiSubscriptionPlanVo"/>
        where p.plan_id = #{planId}
    </select>

    <select id="selectAiSubscriptionPlanList" parameterType="AiSubscriptionPlan" resultMap="AiSubscriptionPlanResult">
        <include refid="selectAiSubscriptionPlanVo"/>
        <where>
            <if test="title != null and title != ''">and p.title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''">and p.status = #{status}</if>
            <if test="allowBalancePurchase != null">and p.allow_balance_purchase = #{allowBalancePurchase}</if>
        </where>
        order by p.sort_order asc, p.plan_id desc
    </select>

    <insert id="insertAiSubscriptionPlan" parameterType="AiSubscriptionPlan" useGeneratedKeys="true" keyProperty="planId">
        insert into ai_subscription_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="subTitle != null">sub_title,</if>
            <if test="priceAmount != null">price_amount,</if>
            <if test="durationUnit != null and durationUnit != ''">duration_unit,</if>
            <if test="durationValue != null">duration_value,</if>
            <if test="customSeconds != null">custom_seconds,</if>
            <if test="amountTotal != null">amount_total,</if>
            <if test="quotaResetPeriod != null and quotaResetPeriod != ''">quota_reset_period,</if>
            <if test="quotaResetCustomSeconds != null">quota_reset_custom_seconds,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="maxPurchasePerUser != null">max_purchase_per_user,</if>
            <if test="allowBalancePurchase != null">allow_balance_purchase,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="subTitle != null">#{subTitle},</if>
            <if test="priceAmount != null">#{priceAmount},</if>
            <if test="durationUnit != null and durationUnit != ''">#{durationUnit},</if>
            <if test="durationValue != null">#{durationValue},</if>
            <if test="customSeconds != null">#{customSeconds},</if>
            <if test="amountTotal != null">#{amountTotal},</if>
            <if test="quotaResetPeriod != null and quotaResetPeriod != ''">#{quotaResetPeriod},</if>
            <if test="quotaResetCustomSeconds != null">#{quotaResetCustomSeconds},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="maxPurchasePerUser != null">#{maxPurchasePerUser},</if>
            <if test="allowBalancePurchase != null">#{allowBalancePurchase},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiSubscriptionPlan" parameterType="AiSubscriptionPlan">
        update ai_subscription_plan
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="subTitle != null">sub_title = #{subTitle},</if>
            <if test="priceAmount != null">price_amount = #{priceAmount},</if>
            <if test="durationUnit != null and durationUnit != ''">duration_unit = #{durationUnit},</if>
            <if test="durationValue != null">duration_value = #{durationValue},</if>
            <if test="customSeconds != null">custom_seconds = #{customSeconds},</if>
            <if test="amountTotal != null">amount_total = #{amountTotal},</if>
            <if test="quotaResetPeriod != null and quotaResetPeriod != ''">quota_reset_period = #{quotaResetPeriod},</if>
            <if test="quotaResetCustomSeconds != null">quota_reset_custom_seconds = #{quotaResetCustomSeconds},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="maxPurchasePerUser != null">max_purchase_per_user = #{maxPurchasePerUser},</if>
            <if test="allowBalancePurchase != null">allow_balance_purchase = #{allowBalancePurchase},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where plan_id = #{planId}
    </update>

    <update id="updateAiSubscriptionPlanStatus">
        update ai_subscription_plan set status = #{status}, update_time = sysdate() where plan_id = #{planId}
    </update>

    <delete id="deleteAiSubscriptionPlanByIds" parameterType="Long">
        delete from ai_subscription_plan where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </delete>
</mapper>
