<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.recharge.mapper.AiRechargeRecordMapper">

    <resultMap type="AiRechargeRecord" id="AiRechargeRecordResult">
        <id     property="recordId"    column="record_id" />
        <result property="userId"      column="user_id" />
        <result property="username"    column="username" />
        <result property="type"        column="type" />
        <result property="amount"      column="amount" />
        <result property="sourceId"    column="source_id" />
        <result property="sourceName"  column="source_name" />
        <result property="status"      column="status" />
        <result property="createBy"    column="create_by" />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by" />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark" />
    </resultMap>

    <sql id="selectAiRechargeRecordVo">
        select record_id, user_id, username, type, amount, source_id, source_name, status,
               create_by, create_time, update_by, update_time, remark
        from ai_recharge_record
    </sql>

    <select id="selectAiRechargeRecordById" parameterType="Long" resultMap="AiRechargeRecordResult">
        <include refid="selectAiRechargeRecordVo"/>
        where record_id = #{recordId}
    </select>

    <select id="selectAiRechargeRecordList" parameterType="AiRechargeRecord" resultMap="AiRechargeRecordResult">
        <include refid="selectAiRechargeRecordVo"/>
        <where>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="type != null and type != ''">and type = #{type}</if>
            <if test="sourceName != null and sourceName != ''">and source_name like concat('%', #{sourceName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by record_id desc
    </select>

    <insert id="insertAiRechargeRecord" parameterType="AiRechargeRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into ai_recharge_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="username != null and username != ''">username,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="amount != null">amount,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="sourceName != null and sourceName != ''">source_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="username != null and username != ''">#{username},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="amount != null">#{amount},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="sourceName != null and sourceName != ''">#{sourceName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

</mapper>
