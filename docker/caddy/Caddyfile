# ============================================
# cpa-external 宿主机 Caddy 配置（模板）
#
# Caddy 直接安装在服务器上（不再做成容器）：
#   安装：见 docker/DEPLOY.md「宿主机 Caddy」一节
#   位置：/etc/caddy/Caddyfile（从本模板复制后按需修改域名和前端目录）
#   生效：systemctl reload caddy
#
# 前端为独立发布的静态文件，上传到下方 root 指定的目录（默认
# /opt/cpa-external/frontend）；后端 jar 由 docker 容器运行，仅绑定
# 宿主机回环 127.0.0.1:8080。
# ============================================
api.cbc.icu {
    encode zstd gzip

    reverse_proxy 127.0.0.1:8317 {
        # 关闭响应缓冲，保证 SSE / 流式输出实时返回
        flush_interval -1

        header_up Host                {host}
        header_up X-Real-IP           {remote_host}
        header_up X-Forwarded-For     {remote_host}
        header_up X-Forwarded-Proto   {scheme}

        # 大模型请求耗时较长，放宽超时
        transport http {
            read_timeout  30m
            write_timeout 30m
            dial_timeout  10s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }
}
ai.cbc.icu {
    encode zstd gzip

    # 安全头
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    # 管理接口：剥离 /prod-api 前缀后转给应用容器
    handle_path /prod-api/* {
        reverse_proxy 43.163.69.198:8080 {
        	# 关闭响应缓冲，保证 SSE / 流式输出实时返回
	        flush_interval -1

	        header_up Host                {host}
	        header_up X-Real-IP           {remote_host}
	        header_up X-Forwarded-For     {remote_host}
	        header_up X-Forwarded-Proto   {scheme}

	        # 管理端请求耗时较长，放宽超时
	        transport http {
	            read_timeout  30m
	            write_timeout 30m
	            dial_timeout  10s
	        }
        }
    }

    # 前端页面：直接托管服务器上的静态文件目录
    handle {
        root * /opt/cpa-external/frontend
        # history 路由直达（如 /pay/result）回退到 index.html
        try_files {path} /index.html
        file_server

        @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
        header @static Cache-Control "public, max-age=604800, immutable"
    }
}
