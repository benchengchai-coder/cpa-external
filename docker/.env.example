# ============================================
# cpa-external Docker 部署环境变量
# 使用方法：cp .env.example .env && nano .env
#
# 域名与 HTTPS 证书在宿主机 Caddy 配置中维护（见 caddy/Caddyfile 模板），
# 与本文件无关。
# ============================================

# ---- 应用镜像（GitHub Actions 自动构建推送 GHCR）----
# GitHub 用户名（小写），用于拼接镜像拉取地址
GHCR_OWNER=benchengchai-coder
# 镜像标签：latest 跟踪最新构建；回滚时改成指定 commit 短哈希（Actions 构建日志/镜像 Tags 页可查）
IMAGE_TAG=latest

# ---- MySQL（必填）----
MYSQL_ROOT_PASSWORD=Cbc940209,.
# 数据库名（含连字符的库名在 SQL 中需反引号转义，统一用下划线）
MYSQL_DATABASE=cpa_external

# ---- Redis（必填）----
REDIS_PASSWORD=Cbc940209,.

# ---- 应用密钥（必填）----
# JWT 令牌密钥（生产环境务必修改）
TOKEN_SECRET=Cbc940209,.

# 邮件配置加密密钥
RUOYI_MAIL_SECRET=Cbc940209,.

# ---- 应用 JVM 参数（可选）----
# 注入容器的 JAVA_TOOL_OPTIONS，按机器内存调整
# 注意：值必须加引号（deploy-server.sh 会 source 本文件，含空格的裸值会被 bash 当作命令）
JAVA_OPTS="-Xms512m -Xmx2048m"

# ---- CLIProxyAPI 用量订阅 ----
# CLIProxyAPI 项目：https://github.com/router-for-me/CLIProxyAPI
# RESP 用量队列文档：https://help.router-for.me/cn/management/redis-usage-queue
# 启用前需在 CLIProxyAPI 中设置 usage-statistics-enabled: true、配置 Management Key；跨容器连接还需允许远程管理访问。
CPA_CLIPROXY_USAGE_SUBSCRIPTION_ENABLED=false
# CLIProxyAPI 与 HTTP API 复用的地址和端口；容器访问宿主机可使用 host.docker.internal。
CPA_CLIPROXY_USAGE_HOST=host.docker.internal
CPA_CLIPROXY_USAGE_PORT=8317
CPA_CLIPROXY_MANAGEMENT_KEY=
# API Key 推送同步：开启后平台侧 Key 新增/轮换/删除/停启用自动写入 CLIProxyAPI 的 api-keys 列表并热加载生效；
# 推送失败可通过管理端"手动同步"补偿。需要 CLIProxyAPI 开启远程管理（remote-management.allow-remote: true）。
CPA_CLIPROXY_APIKEY_PUSH_ENABLED=false
# CLIProxyAPI 对外监听启用 TLS/HTTPS 时改为 true。
CPA_CLIPROXY_USAGE_TLS=false

# ---- CLIProxyAPI 公开计费 API ----
# CLIProxyAPI 请求前预占（/aigate/billing/reserve|release|check）的鉴权 Token（请求头 X-Billing-Token）；
# 为空时公开计费接口拒绝所有请求。对接契约见 docs/cliproxy-billing-integration.md。
CPA_BILLING_API_TOKEN=Cbc940209,.
# 预占超时时间（秒），超时未结算的预占由定时任务释放。
CPA_BILLING_RESERVATION_TIMEOUT_SECONDS=3600
# usage 落库后到结算的延迟窗口（秒），聚合凭据重试产生的多条 usage。
CPA_BILLING_SETTLE_DELAY_SECONDS=5

# ---- 支付宝在线充值（业务开关在 sys_config：ai.pay.onlineRechargeEnabled）----
# 是否沙箱环境
ALIPAY_SANDBOX=false
# 支付宝应用 ID
ALIPAY_APP_ID=
# 应用私钥（PKCS8，去掉头尾与换行）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（异步通知验签）
ALIPAY_PUBLIC_KEY=
# 异步通知地址，支付宝服务器直接 POST，必须经 Caddy 反代到后端，故带 /prod-api 前缀
ALIPAY_NOTIFY_URL=https://cbc.icu/prod-api/aigate/pay/alipay/notify
# 同步回跳地址（浏览器跳前端结果页），前端为 SPA 不带 /prod-api 前缀
ALIPAY_RETURN_URL=https://cbc.icu/pay/result

# ---- 可选配置（一般无需修改）----
# 文件上传路径（容器内路径）
UPLOAD_PATH=/home/ruoyi/uploadPath
